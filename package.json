{
  "name": "ddb-debugger",
  "displayName": "DDB debugger",
  "description": "Distributed debug adapter for DDB",
  "keywords": [
    "gdb",
    "distributed-debugger",
    "ddb"
  ],
  "license": "public domain",
  "version": "0.0.11",
  "publisher": "ddb",
  "icon": "images/ddbicon.webp",
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18"
  },
  "main": "./out/src/frontend/extension.js",
  "activationEvents": [
    "onDebugResolve:ddb",
    "onDebugDynamicConfigurations:ddb"
  ],
  "categories": [
    "Debuggers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/USC-NSL/Distributed-debugger-adapter"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "DDB Debugger",
      "properties": {
        "ddb.serviceUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "DDB backend service URL (e.g., http://localhost:5000). Used for both HTTP API and WebSocket notifications.",
          "deprecationMessage": "Use apiEndpoint in launch.json for an existing DDB server. Managed launches discover their endpoint automatically."
        },
        "ddb.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use adapter state events for real-time sidebar updates."
        },
        "ddb.pollMaxAttempts": {
          "type": "number",
          "default": 30,
          "description": "Maximum number of attempts to poll DDB service for readiness",
          "minimum": 1,
          "maximum": 100
        },
        "ddb.pollIntervalMs": {
          "type": "number",
          "default": 1000,
          "description": "Interval in milliseconds between DDB service polling attempts",
          "minimum": 100,
          "maximum": 10000
        },
        "ddb.sessionManager.autoRefreshMs": {
          "type": "number",
          "default": 15000,
          "description": "Auto-refresh interval for session manager data during active debug session (milliseconds)",
          "minimum": 1000,
          "maximum": 300000
        },
        "ddb.breakpointManager.autoRefreshMs": {
          "type": "number",
          "default": 15000,
          "description": "Auto-refresh interval for breakpoint manager data during active debug session (milliseconds)",
          "minimum": 1000,
          "maximum": 300000
        },
        "ddb.otel.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable OpenTelemetry telemetry (tracing, metrics, logging)"
        },
        "ddb.otel.endpoint": {
          "type": "string",
          "default": "http://ruby1.nsl.usc.edu:54317",
          "description": "OpenTelemetry OTLP gRPC endpoint for sending telemetry data"
        },
        "ddb.disclaimer.neverShowAgain": {
          "type": "boolean",
          "default": false,
          "description": "If true, the usage collection disclaimer will not be shown on debug session start"
        }
      }
    },
    "commands": [
      {
        "command": "ddbSessionsExplorer.refresh",
        "title": "Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "ddbSessionsExplorer.toggleGrouping",
        "title": "Toggle Logical Groups",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "ddbBreakpointsExplorer.focusHit",
        "title": "Go to Paused Frame",
        "icon": "$(debug-stackframe)"
      },
      {
        "command": "ddbBreakpointsExplorer.openSource",
        "title": "Go to Breakpoint Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ddbBreakpointsExplorer.refresh",
        "title": "Refresh Breakpoints",
        "icon": "$(refresh)"
      },
      {
        "command": "ddbBreakpointsExplorer.toggleGroupByFile",
        "title": "Group Breakpoints by File",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "ddbBreakpointsExplorer.showFlat",
        "title": "Show Flat Breakpoint List",
        "icon": "$(list-flat)"
      },
      {
        "command": "ddbSessionsExplorer.showLogicalGroupDetails",
        "title": "Show Logical Group Details",
        "icon": "$(info)"
      },
      {
        "command": "ddbSessionsExplorer.pauseSession",
        "title": "Pause Session",
        "icon": "$(debug-pause)"
      },
      {
        "command": "ddbSessionsExplorer.continueSession",
        "title": "Continue Session",
        "icon": "$(debug-continue)"
      },
      {
        "command": "ddbSessionsExplorer.killSession",
        "title": "Kill Session",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ddbSessionsExplorer.sendSignal",
        "title": "Send Signal",
        "icon": "$(broadcast)"
      },
      {
        "command": "ddb.jumpToFocusedFrame",
        "title": "Jump to Focused Frame",
        "icon": "$(target)"
      },
      {
        "command": "ddbSessionsExplorer.copyDetails",
        "title": "Copy Session Details",
        "icon": "$(copy)"
      }
    ],
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "cpp"
      },
      {
        "language": "d"
      },
      {
        "language": "objective-c"
      },
      {
        "language": "fortran"
      },
      {
        "language": "fortran-modern"
      },
      {
        "language": "fortran90"
      },
      {
        "language": "fortran_free-form"
      },
      {
        "language": "fortran_fixed-form"
      },
      {
        "language": "rust"
      },
      {
        "language": "pascal"
      },
      {
        "language": "objectpascal"
      },
      {
        "language": "ada"
      },
      {
        "language": "nim"
      },
      {
        "language": "arm"
      },
      {
        "language": "asm"
      },
      {
        "language": "vala"
      },
      {
        "language": "crystal"
      },
      {
        "language": "kotlin"
      },
      {
        "language": "zig"
      },
      {
        "language": "riscv"
      }
    ],
    "debuggers": [
      {
        "type": "ddb",
        "program": "./out/src/gdb.js",
        "runtime": "node",
        "label": "Distributed Debugger",
        "languages": [
          "c",
          "cpp",
          "d",
          "objective-c",
          "fortran",
          "fortran-modern",
          "fortran90",
          "fortran_free-form",
          "fortran_fixed-form",
          "rust",
          "pascal",
          "objectpascal",
          "ada",
          "nim",
          "arm",
          "asm",
          "vala",
          "crystal",
          "kotlin",
          "zig",
          "riscv"
        ],
        "variables": {
          "FileBasenameNoExt": "code-debug.getFileBasenameNoExt",
          "FileNameNoExt": "code-debug.getFileNameNoExt"
        },
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "target": {
                "type": "string",
                "description": "Path of executable",
                "deprecationMessage": "The DDB YAML launcher does not use this inherited GDB setting. Configure target processes and remote execution in the DDB YAML configuration."
              },
              "arguments": {
                "type": "string",
                "description": "Arguments to append after the executable. You can also use pipes.",
                "deprecationMessage": "The DDB YAML launcher does not use this inherited GDB setting. Configure target processes and remote execution in the DDB YAML configuration."
              },
              "terminal": {
                "type": "string",
                "description": "Leave this field undefined to keep program output in the vscode console at the bottom. If this is set to empty string the program will spawn in a new console using x-terminal-emulator on linux, otherwise with the specified terminal. On windows setting this to an empty string spawns the program in a console, but no other console is supported.",
                "deprecationMessage": "The DDB YAML launcher does not use this inherited GDB setting. Configure target processes and remote execution in the DDB YAML configuration."
              },
              "cwd": {
                "type": "string",
                "description": "project path"
              },
              "ddbpath": {
                "type": "string",
                "description": "Path to the ddb executable or the command if in PATH",
                "default": "ddb"
              },
              "configFilePath": {
                "type": "string",
                "description": "DDB YAML configuration for a managed launch. Required unless apiEndpoint connects to an existing server.",
                "default": null
              },
              "env": {
                "type": "object",
                "description": "Environment overrides for the managed DDB process. Set a value to null to remove it.",
                "default": null,
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "debugger_args": {
                "type": "array",
                "description": "Additional arguments for ddb serve. The adapter manages endpoint, authentication and startup-report options.",
                "default": [],
                "items": {
                  "type": "string"
                }
              },
              "pathSubstitutions": {
                "type": "object",
                "description": "Help GDB find your source using path substitutions (GDB `substitute-path)` variable",
                "default": {
                  "<fromPath>": "<toPath>"
                }
              },
              "valuesFormatting": {
                "type": "string",
                "description": "Variable display mode: 'disabled' shows values without expansion; 'parseText' expands structured debugger values without enabling pretty-printers; 'prettyPrinters' also enables GDB pretty-printers.",
                "default": "prettyPrinters",
                "enum": [
                  "disabled",
                  "parseText",
                  "prettyPrinters"
                ]
              },
              "printCalls": {
                "type": "boolean",
                "description": "Print canonical DDB API request methods, operation paths and HTTP status to the Debug Console. Excludes headers and payloads.",
                "default": false
              },
              "showDevDebugOutput": {
                "type": "boolean",
                "description": "Show managed DDB process output used for diagnosing startup and server issues.",
                "default": false
              },
              "autorun": {
                "type": "array",
                "description": "GDB commands to run when starting to debug",
                "default": []
              },
              "stopAtEntry": {
                "type": [
                  "boolean",
                  "string"
                ],
                "description": "Install a temporary breakpoint at main (true) or the named function after initial DDB sessions are ready. Does not resume execution; initial process stopping is configured in DDB YAML.",
                "default": false
              },
              "ssh": {
                "required": [
                  "host",
                  "user",
                  "cwd"
                ],
                "type": "object",
                "description": "If this is set then the extension will connect to an ssh host and run GDB there",
                "properties": {
                  "host": {
                    "type": "string",
                    "description": "Remote host name/ip to connect to"
                  },
                  "port": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "Remote port number",
                    "default": 22
                  },
                  "user": {
                    "type": "string",
                    "description": "Username to connect as"
                  },
                  "password": {
                    "type": "string",
                    "description": "Plain text password (unsafe; if possible use keyfile instead)"
                  },
                  "keyfile": {
                    "type": "string",
                    "description": "Absolute path to private key"
                  },
                  "useAgent": {
                    "type": "boolean",
                    "description": "Auto-detect the running SSH agent (via SSH_AUTH_SOCK environment variable) and use it to perform authentication",
                    "default": false
                  },
                  "sourceFileMap": {
                    "type": "object",
                    "description": "Mapping of source paths (from GDB on ssh remote) to local (IDE) paths.",
                    "default": {
                      "<sourcePath>": "<localPath>"
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "description": "Working directory for the debugger.\nIf `ssh.sourceFileMap` is not set, then this is also the project path on the remote for mapping with `cwd`."
                  },
                  "forwardX11": {
                    "type": "boolean",
                    "description": "If true, the server will redirect x11 to the local host",
                    "default": true
                  },
                  "x11port": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "Port to redirect X11 data to (by default port = display + 6000)",
                    "default": 6000
                  },
                  "x11host": {
                    "type": "string",
                    "description": "Hostname/ip to redirect X11 data to",
                    "default": "localhost"
                  },
                  "remotex11screen": {
                    "type": "number",
                    "description": "Screen to start the application on the remote side",
                    "default": 0
                  },
                  "bootstrap": {
                    "type": "string",
                    "description": "Content will be executed on the SSH host before the debugger call."
                  }
                },
                "deprecationMessage": "The DDB YAML launcher does not use this inherited GDB setting. Configure target processes and remote execution in the DDB YAML configuration."
              },
              "apiEndpoint": {
                "type": "string",
                "description": "Connect to an existing DDB API v2 server instead of starting a managed DDB process."
              },
              "apiToken": {
                "type": "string",
                "description": "Bearer token for apiEndpoint. Defaults to the DDB_API_TOKEN environment variable."
              },
              "distributedStack": {
                "type": "boolean",
                "default": true,
                "description": "Show the distributed backtrace across DDB sessions."
              }
            }
          },
          "attach": {
            "required": [
              "apiEndpoint"
            ],
            "properties": {
              "target": {
                "type": "string",
                "description": "PID of running program or program name or connection arguments (eg :2345) if remote is true"
              },
              "remote": {
                "type": "boolean",
                "description": "If true this will connect to a gdbserver instead of attaching to a PID",
                "default": false
              },
              "valuesFormatting": {
                "type": "string",
                "description": "Variable display mode: 'disabled' shows values without expansion; 'parseText' expands structured debugger values without enabling pretty-printers; 'prettyPrinters' also enables GDB pretty-printers.",
                "default": "parseText",
                "enum": [
                  "disabled",
                  "parseText",
                  "prettyPrinters"
                ]
              },
              "printCalls": {
                "type": "boolean",
                "description": "Print canonical DDB API request methods, operation paths and HTTP status to the Debug Console. Excludes headers and payloads.",
                "default": false
              },
              "showDevDebugOutput": {
                "type": "boolean",
                "description": "Prints all GDB responses to the console",
                "default": false
              },
              "executable": {
                "type": "string",
                "description": "Path of executable for debugging symbols"
              },
              "gdbpath": {
                "type": "string",
                "description": "Path to the gdb executable or the command if in PATH",
                "default": "gdb"
              },
              "env": {
                "type": "object",
                "description": "Environment overriding the gdb (and in turn also the process) environment",
                "default": null
              },
              "debugger_args": {
                "type": "array",
                "description": "Additional arguments to pass to GDB",
                "default": []
              },
              "pathSubstitutions": {
                "type": "object",
                "description": "Help GDB find your source using path substitutions (GDB `substitute-path)` variable",
                "default": {
                  "<fromPath>": "<toPath>"
                }
              },
              "cwd": {
                "type": "string",
                "description": "project path",
                "default": "${workspaceRoot}"
              },
              "autorun": {
                "type": "array",
                "description": "GDB commands to run when starting to debug",
                "default": []
              },
              "stopAtConnect": {
                "type": "boolean",
                "description": "Whether debugger should stop after connecting to target",
                "default": false
              },
              "stopAtEntry": {
                "type": [
                  "boolean",
                  "string"
                ],
                "description": "Install a temporary breakpoint at main (true) or the named function after initial DDB sessions are ready. Does not resume execution; initial process stopping is configured in DDB YAML.",
                "default": false
              },
              "ssh": {
                "required": [
                  "host",
                  "cwd",
                  "user"
                ],
                "type": "object",
                "description": "If this is set then the extension will connect to an ssh host and run GDB there",
                "properties": {
                  "host": {
                    "type": "string",
                    "description": "Remote host name/ip to connect to"
                  },
                  "port": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "Remote port number",
                    "default": 22
                  },
                  "user": {
                    "type": "string",
                    "description": "Username to connect as"
                  },
                  "password": {
                    "type": "string",
                    "description": "Plain text password (unsafe; if possible use keyfile instead)"
                  },
                  "keyfile": {
                    "type": "string",
                    "description": "Absolute path to private key"
                  },
                  "useAgent": {
                    "type": "boolean",
                    "description": "Auto-detect the running SSH agent (via SSH_AUTH_SOCK environment variable) and use it to perform authentication",
                    "default": false
                  },
                  "sourceFileMap": {
                    "type": "object",
                    "description": "Mapping of source paths (from GDB on ssh remote) to local (IDE) paths.",
                    "default": {
                      "<sourcePath>": "<localPath>"
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "description": "Working directory for the debugger.\nIf `ssh.sourceFileMap` is not set, then this is also the project path on the remote for mapping with `cwd`."
                  },
                  "forwardX11": {
                    "type": "boolean",
                    "description": "If true, the server will redirect x11 to the local host",
                    "default": true
                  },
                  "x11port": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "Port to redirect X11 data to (by default port = display + 6000)",
                    "default": 6000
                  },
                  "x11host": {
                    "type": "string",
                    "description": "Hostname/ip to redirect X11 data to",
                    "default": "localhost"
                  },
                  "remotex11screen": {
                    "type": "number",
                    "description": "Screen to start the application on the remote side",
                    "default": 0
                  },
                  "bootstrap": {
                    "type": "string",
                    "description": "Content will be executed on the SSH host before the debugger call."
                  }
                }
              },
              "apiEndpoint": {
                "type": "string",
                "description": "Connect to an existing DDB API v2 server instead of starting a managed DDB process."
              },
              "apiToken": {
                "type": "string",
                "description": "Bearer token for apiEndpoint. Defaults to the DDB_API_TOKEN environment variable."
              },
              "distributedStack": {
                "type": "boolean",
                "default": true,
                "description": "Show the distributed backtrace across DDB sessions."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "DDB: Launch configuration",
            "type": "ddb",
            "request": "launch",
            "configFilePath": "${workspaceFolder}/ddb.yaml",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "DDB: Launch configuration",
            "description": "Start a managed DDB server using a YAML configuration.",
            "body": {
              "type": "ddb",
              "request": "launch",
              "name": "DDB: Launch configuration",
              "configFilePath": "^\"\\${workspaceFolder}/ddb.yaml\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "DDB: Attach to server",
            "description": "Connect to an existing canonical DDB server. Disconnect leaves that server running.",
            "body": {
              "type": "ddb",
              "request": "attach",
              "name": "DDB: Attach to server",
              "apiEndpoint": "http://127.0.0.1:${1:port}",
              "apiToken": "^\"\\${env:DDB_API_TOKEN}\""
            }
          }
        ]
      }
    ],
    "views": {
      "debug": [
        {
          "id": "ddbSessionsExplorer",
          "name": "DDB Sessions"
        },
        {
          "id": "ddbBreakpointsExplorer",
          "name": "DDB Breakpoints"
        }
      ]
    },
    "menus": {
      "debug/toolBar": [
        {
          "command": "ddb.jumpToFocusedFrame",
          "when": "debugState == stopped && debugType == ddb",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "ddbSessionsExplorer.toggleGrouping",
          "when": "view == ddbSessionsExplorer",
          "group": "navigation"
        },
        {
          "command": "ddbSessionsExplorer.refresh",
          "when": "view == ddbSessionsExplorer",
          "group": "navigation"
        },
        {
          "command": "ddbBreakpointsExplorer.showFlat",
          "when": "view == ddbBreakpointsExplorer && ddb.breakpointsGroupedByFile",
          "group": "navigation"
        },
        {
          "command": "ddbBreakpointsExplorer.toggleGroupByFile",
          "when": "view == ddbBreakpointsExplorer && !ddb.breakpointsGroupedByFile",
          "group": "navigation"
        },
        {
          "command": "ddbBreakpointsExplorer.refresh",
          "when": "view == ddbBreakpointsExplorer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ddbBreakpointsExplorer.toggleGroupByFile",
          "when": "!ddb.breakpointsGroupedByFile"
        },
        {
          "command": "ddbBreakpointsExplorer.showFlat",
          "when": "ddb.breakpointsGroupedByFile"
        }
      ],
      "view/item/context": [
        {
          "command": "ddbBreakpointsExplorer.focusHit",
          "when": "view == ddbBreakpointsExplorer && viewItem =~ /Hit$/",
          "group": "inline@0"
        },
        {
          "command": "ddbBreakpointsExplorer.openSource",
          "when": "view == ddbBreakpointsExplorer && viewItem =~ /^sourceBreakpointItem/",
          "group": "inline@1"
        },
        {
          "command": "ddbSessionsExplorer.sendSignal",
          "when": "view == ddbSessionsExplorer && viewItem =~ /^sessionItem[.]/",
          "group": "sessionControl@2"
        },
        {
          "command": "ddbSessionsExplorer.killSession",
          "when": "view == ddbSessionsExplorer && viewItem =~ /^sessionItem[.]/",
          "group": "sessionControl@3"
        },
        {
          "command": "ddbSessionsExplorer.pauseSession",
          "when": "view == ddbSessionsExplorer && viewItem == sessionItem.running",
          "group": "inline@1"
        },
        {
          "command": "ddbSessionsExplorer.continueSession",
          "when": "view == ddbSessionsExplorer && viewItem == sessionItem.paused",
          "group": "inline@1"
        },
        {
          "command": "ddbSessionsExplorer.showLogicalGroupDetails",
          "when": "view == ddbSessionsExplorer && viewItem == logicalGroup",
          "group": "inline"
        },
        {
          "command": "ddbSessionsExplorer.copyDetails",
          "when": "view == ddbSessionsExplorer && viewItem =~ /^sessionItem[.]/",
          "group": "sessionDetails@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "test": "tsc -p ./ && mocha",
    "coverage": "nyc npm test",
    "compile": "tsc -watch -p ./",
    "lint": "eslint src scripts --ext .ts,.mts,.cjs --max-warnings 0 && prettier --check \"src/**/*.{ts,mts}\" \"scripts/**/*.cjs\"",
    "lint-and-fix": "eslint src scripts --ext .ts,.mts,.cjs --fix && prettier --write \"src/**/*.{ts,mts}\" \"scripts/**/*.cjs\"",
    "spellcheck-docs": "cspell lint **/*.md",
    "lint-docs": "markdownlint **/*.md",
    "link-check": "markdown-link-check *.md",
    "prettier-write-docs": "prettier --write **/*.md",
    "prettier-check-docs": "prettier --check **/*.md",
    "test:integration": "tsc -p ./ && node -e \"if (!process.env.DDB_TEST_BINARY) throw new Error('Set DDB_TEST_BINARY to the current DDB executable')\" && mocha --no-config --ui tdd out/src/test/integration/**/*.test.js",
    "test:canonical": "tsc -p ./ && node -e \"if (!process.env.DDB_TEST_BINARY) throw new Error('Set DDB_TEST_BINARY to the current DDB executable')\" && mocha --no-config --ui tdd \"out/src/test/integration/canonical*.test.mjs\"",
    "test:extension": "tsc -p ./ && node scripts/test-extension.cjs"
  },
  "dependencies": {
    "@ddb-debugger/api-client": "file:vendor/ddb-debugger-api-client-0.1.0-10f0f8aa.tgz",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.57.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
