{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DDB: gRPC with LLDB",
      "type": "ddb",
      "request": "launch",
      "ddbpath": "/absolute/path/to/ddb",
      "configFilePath": "${workspaceFolder}/.ddb/dbg_grpc_lldb.yaml",
      "cwd": "${workspaceFolder}",
      "distributedStack": true,
      "valuesFormatting": "prettyPrinters",
      "env": { "DEBUGINFOD_URLS": "" }
    }
  ]
}
