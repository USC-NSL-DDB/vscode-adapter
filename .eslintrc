{
	"env": {
		"es6": true,
		"node": true
	},
	"extends": [
		"eslint:recommended",
		"plugin:@typescript-eslint/eslint-recommended",

		"plugin:@typescript-eslint/recommended"
	],
	"parser": "@typescript-eslint/parser",
	"parserOptions": {
		"ecmaVersion": "latest",
		"project": "./tsconfig.json",
		"sourceType": "module"
	},
	"plugins": [
		"eslint-plugin-deprecation",
		"@typescript-eslint"
	],
	"root": true,
	"rules": {
		// Configure additional checks
		"comma-spacing": "error",
		"deprecation/deprecation": "error",
		"eol-last": "error",
		// Prettier handles TypeScript indentation; core indent does not understand TS nodes.
		"indent": "off",
		"no-mixed-spaces-and-tabs": ["error", "smart-tabs"],
		"no-console": ["error", {"allow": ["warn", "error"]}],
		"no-trailing-spaces": "error",
		"prefer-const": ["error", {"ignoreReadBeforeAssign": true}],
		"semi": "error",
		"space-infix-ops": "error",
		"@typescript-eslint/ban-tslint-comment": "error",
		// Protocol augmentation uses ambient namespaces; runtime namespaces remain banned.
		"@typescript-eslint/no-namespace": ["error", {"allowDeclarations": true}],
		// VS Code is optional in modules shared with the standalone adapter process.
		"@typescript-eslint/no-require-imports": ["error", {"allow": ["^vscode$"]}],

		// Disable some recommended checks (until we can address them)
		"no-cond-assign": "off",
		"no-fallthrough": "off",
		"no-prototype-builtins": "off",
		"no-useless-escape": "off",
		"prefer-spread": "off",
		"@typescript-eslint/ban-types": "off",
		"@typescript-eslint/no-explicit-any": "off",
		"@typescript-eslint/no-inferrable-types": "off",
		"@typescript-eslint/no-unused-vars": "off"
	},
	"overrides": [
		{
			"files": ["src/test/**/*", "src/frontend/**/*", "src/common/ddb_session_mgr.ts", "src/common/ddb_breakpoint_mgr.ts", "src/common/legacy_ddb_notification_service.ts", "src/DDBViewProvider.ts", "src/sessionControls.ts"],
			"rules": {"no-console": "off"}
		},
		{
			"files": ["scripts/**/*.cjs"],
			"parser": "espree",
			"parserOptions": {"project": null, "sourceType": "script"},
			"globals": {"fetch": "readonly", "WebSocket": "readonly"},
			"rules": {
				"deprecation/deprecation": "off",
				"@typescript-eslint/no-require-imports": "off",
				"no-empty": ["error", {"allowEmptyCatch": true}]
			}
		}
	]
}
